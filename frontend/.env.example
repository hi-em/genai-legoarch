# VITE_API_BASE — the backend's absolute origin, baked in at BUILD time.
#
# Leave it UNSET for the normal deployment: FastAPI serves this SPA and the API
# from the SAME origin (see docs/deploy.md), so "/api/..." already resolves to
# the right place and setting this would point the app at a foreign host.
#
# Only needed if you deliberately split the frontend onto a different host —
# and then the backend also needs ALLOWED_ORIGINS set to match. No trailing slash.
# VITE_API_BASE=https://legoarch.charlesabichahine.com
